{
  "tool": "html-validate",
  "config": {
    "extends": [
      "html-validate:recommended"
    ],
    "rules": {
      "attr-case": "off",
      "void-style": "off",
      "attribute-boolean-style": "off",
      "attribute-empty-style": "off",
      "valid-id": [
        "error",
        {
          "relaxed": true
        }
      ]
    }
  },
  "adjustedRules": [
    "attr-case",
    "void-style",
    "attribute-boolean-style",
    "attribute-empty-style",
    "valid-id"
  ],
  "adjustedRulesReason": "Next.js (React) writes valid HTML in a style the recommended preset does not prefer: camelCase attribute names that HTML treats case-insensitively (charSet, dateTime, noValidate, autoComplete, maxLength), self-closing void tags (<link .../>), boolean attributes with empty values (async=\"\", disabled=\"\", hidden=\"\"), and an element id that starts with an underscore. The template cannot change this output, so attr-case, void-style, attribute-boolean-style and attribute-empty-style are off, and valid-id is relaxed (the HTML standard allows any id without spaces; our own heading ids may start with a digit). Every other rule of the preset stays on.",
  "messagesWithUnmodifiedPresetByRule": {
    "attr-case": 104,
    "void-style": 615,
    "attribute-boolean-style": 148,
    "attribute-empty-style": 32,
    "valid-id": 20
  },
